{
  "shell": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>LYNQ sample prototype</title><style>*{box-sizing:border-box}body{font:16px system-ui;margin:0;padding:24px;background:#eef7f5;color:#0b2338}main{max-width:680px;margin:auto;background:white;border:1px solid #c7dcda;padding:24px;border-radius:16px}button{font:inherit;padding:12px;margin:6px;border:1px solid #087d79;border-radius:8px;background:#087d79;color:white}button:focus-visible{outline:3px solid #0b2338;outline-offset:2px}p{line-height:1.6;overflow-wrap:anywhere}small{color:#496674}[hidden]{display:none}</style></head><body><main><small>LOCAL SAMPLE SHELL · FICTIONAL DATA · NO API</small><h1 id=\"title\"></h1><p id=\"spec\"></p><div id=\"entry\"><h2>Sample invitation</h2><button id=\"start\">Explore sample routes</button></div><div id=\"choices\" hidden><h2>Choose a sample route</h2><button id=\"available\">Available route</button><button id=\"unavailable\">Unavailable route</button><button id=\"cancel\">Cancel</button></div><div id=\"recovery\" hidden><h2>Sample route unavailable</h2><p>No registration was made. Choose another route or exit.</p><button id=\"retry\">Back to choices</button><button id=\"exit\">Exit</button></div><div id=\"destination\" hidden><h2>Sample destination</h2><p>You reached the fictional destination screen. No account, payment or registration exists.</p><button id=\"restart\">Restart</button></div><p id=\"status\" role=\"status\"></p></main><script>const cfg=__CONFIG__;document.getElementById('title').textContent=cfg.title;document.getElementById('spec').textContent=cfg.spec;function show(id){['entry','choices','recovery','destination'].forEach(x=>document.getElementById(x).hidden=x!==id);document.getElementById('status').textContent='Current sample state: '+id;document.querySelector('#'+id+' h2').tabIndex=-1;document.querySelector('#'+id+' h2').focus()}[['start','choices'],['available','destination'],['unavailable','recovery'],['cancel','entry'],['retry','choices'],['exit','entry'],['restart','entry']].forEach(([id,to])=>document.getElementById(id).onclick=()=>show(to));</script></body></html>"
}
